# =============================================================================
# Telegram VPN Bot
# =============================================================================

TELEGRAM_BOT_TOKEN=your_bot_token_here
# BOT_TOKEN=your_bot_token_here

# Webhook (production) — leave empty for local polling
WEBHOOK_URL=https://your-domain.com/bot
PORT=8443

# Admin numeric Telegram user ID (required for order/payment notifications)
# Get yours: send /myid to the bot
ADMIN_ID=123456789
# Multiple admins (optional): ADMIN_IDS=111111,222222

# Card-to-card payment (shown to users in wallet top-up)
CARD_NUMBER=6037-XXXX-XXXX-XXXX
CARD_HOLDER=Your Name

# Support link (Contact Admin button)
SUPPORT_URL=https://t.me/your_support

# Optional: require channel membership before /start
CHANNEL_ID=@your_channel
CHANNEL_URL=https://t.me/your_channel

# 3x-ui / sanaie panel (automatic test config — one 40MB sub link per Telegram user)
XUI_PANEL_URL=https://your-panel.com:2053/your-path
XUI_USERNAME=admin
XUI_PASSWORD=your_panel_password
XUI_INBOUND_ID=1
XUI_SUB_URL=https://your-panel.com:2096/sub
# VLESS+WS+TLS (like inbound #1): leave flow empty. Use xtls-rprx-vision only for Reality.
XUI_CLIENT_FLOW=
XUI_LIMIT_IP=0
XUI_TEST_TRAFFIC_MB=40
# XUI_TEST_EXPIRY_DAYS=7
# XUI_VERIFY_SSL=false
