# =============================================================================
# Telegram VPN Bot
# =============================================================================

TELEGRAM_BOT_TOKEN=your_bot_token_here
# BOT_TOKEN=your_bot_token_here

# Webhook (production) — leave empty for local polling
WEBHOOK_URL=https://your-domain.com/bot
PORT=8443

# Admin numeric Telegram user ID (required for order/payment notifications)
# Get yours: send /myid to the bot
ADMIN_ID=123456789
# Multiple admins (optional): ADMIN_IDS=111111,222222

# Card-to-card payment (shown to users in wallet top-up)
CARD_NUMBER=6037-XXXX-XXXX-XXXX
CARD_HOLDER=Your Name

# Support link (Contact Admin button)
SUPPORT_URL=https://t.me/your_support

# Optional: require channel membership before /start
CHANNEL_ID=@your_channel
CHANNEL_URL=https://t.me/your_channel
